<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Stubborn{% endblock %}</title>
        <meta name="description" content="{% block description %}Stubborn, la marque de sweat-shirts qui ne fait aucun compromis sur le style.{% endblock %}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="border-bottom py-3 mb-4">
            <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
                <a href="{{ path('app_home') }}" class="d-flex align-items-center text-decoration-none">
                    <img src="{{ asset('images/logo.png') }}" alt="Stubborn" height="40" class="me-2">
                    <span class="text-muted small">Don't compromise on your look</span>
                </a>
                <nav>
                    <ul class="nav">
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}fw-bold text-decoration-underline{% endif %}" href="{{ path('app_home') }}">Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_products' %}fw-bold text-decoration-underline{% endif %}" href="{{ path('app_products') }}">Boutique</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_cart' %}fw-bold text-decoration-underline{% endif %}" href="{{ path('app_cart') }}">Panier</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">Se déconnecter</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}fw-bold text-decoration-underline{% endif %}" href="{{ path('app_home') }}">Accueil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_register' %}fw-bold text-decoration-underline{% endif %}" href="{{ path('app_register') }}">S'inscrire</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link {% if app.request.attributes.get('_route') == 'app_login' %}fw-bold text-decoration-underline{% endif %}" href="{{ path('app_login') }}">Se connecter</a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            </div>
        </header>

        <main class="container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="stubborn-footer mt-5 py-4">
            <div class="container">
                <p class="mb-1 fw-bold">Informations de la société</p>
                <p class="mb-0 small">Stubborn - Piccadilly Circus, London W1J 0DA, Royaume-Uni</p>
                <p class="mb-0 small">Contact : stubborn@blabla.com</p>
            </div>
        </footer>
    </body>
</html>
